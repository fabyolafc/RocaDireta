# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores
# para o seu ambiente local. Nunca coloque valores reais neste arquivo
# de exemplo nem commite o seu ".env".

NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:5173

# Necessário a partir da Etapa 2 (Banco de dados), quando as migrations
# forem criadas. Ainda não utilizado pelo código nesta etapa.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rocadireta

# Necessário a partir da Etapa 3 (Autenticação). Ainda não utilizado
# pelo código nesta etapa.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Configure apenas se a recuperação de senha por e-mail for implementada.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Configure apenas se houver integração de IA (Etapa 12).
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=15000

# Configure apenas se houver armazenamento de imagens (Etapa 5).
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
